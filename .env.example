# Server
PORT=3000
NODE_ENV=development

# Database Cloud (Turso / libSQL)
# Kosongkan DATABASE_URL untuk memakai SQLite lokal (data/campus-eats.db)
DATABASE_URL=
DATABASE_AUTH_TOKEN=
DB_FILE=

# Keamanan & Auth (wajib diisi di production, minimal 32 karakter acak)
JWT_SECRET=
CORS_ORIGIN=

# Seeder akun demo (hanya dipakai saat tabel users masih kosong)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_COURIER_PASSWORD=
SEED_MERCHANT_PASSWORD=
